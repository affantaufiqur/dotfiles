#!/bin/bash
SESSION_NAME="work"

# Check if session exists
tmux has-session -t $SESSION_NAME 2>/dev/null

if [ $? != 0 ]; then
    # Create first window
    tmux new-session -d -s $SESSION_NAME -n "appcore"
    tmux send-keys -t $SESSION_NAME:1 "cd ~/deve/appcore" C-m
    tmux send-keys -t $SESSION_NAME:1 "npm run dev:remote" C-m
    tmux rename-pane -t $SESSION_NAME:1 "appcore"

    # Create second window
    tmux new-window -t $SESSION_NAME:2 -n "web"
    tmux send-keys -t $SESSION_NAME:2 "cd ~/deve/dental-app-web" C-m
    tmux send-keys -t $SESSION_NAME:2 "npm run dev" C-m
    tmux rename-pane -t $SESSION_NAME:2 "web"

    # Select first window
    tmux select-window -t $SESSION_NAME:1
fi

# Attach to session
tmux attach-session -t $SESSION_NAME
